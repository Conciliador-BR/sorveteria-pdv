# Set private values in the ignored .env.local, never NEXT_PUBLIC_*.
DATABASE_URL=
# Optional direct connection for migration providers that require it.
DATABASE_URL_UNPOOLED=
# Supabase Auth, used only on the server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: só para o dono criar e editar logins de funcionário.
SUPABASE_SERVICE_ROLE_KEY=
LOG_LEVEL=info
